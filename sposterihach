         << endl;

    cout << "\n--- Druhe vymiriuvannia ---" << endl;

    hub.setMeasurements(
        29.5,
        30.0,
        1011.0
    );

    cout << "\n--- Vidkliuchennia kondytsionera ---" << endl;

    hub.detach(&conditioner);

    cout << "Kilkist prystroiv: "
         << hub.getObserversCount()
         << endl;

    cout << "\n--- Tretie vymiriuvannia ---" << endl;

    hub.setMeasurements(
        23.0,
        45.0,
        1013.0
    );

    cout << "\n========================================" << endl;
    cout << "Robotu prohramy zaversheno." << endl;
    cout << "Aktyvnykh prystroiv: "
         << hub.getObserversCount()
         << endl;
    cout << "========================================" << endl;

    return 0;
}
